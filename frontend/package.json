{
  "name": "jcpress-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fonts:chars": "node scripts/collect-charset.cjs",
    "fonts:chars:display": "node scripts/collect-display-charset.cjs",
    "fonts:chars:article": "node scripts/gen-article-charset.cjs",
    "fonts:build:article": "node scripts/gen-article-charset.cjs && node scripts/build-font-subset.cjs --weight=500 --chars=.tmp/fonts/chars-article.txt --collect=none --out=serif-sc-article-500.woff2 && node scripts/build-font-subset.cjs --weight=700 --chars=.tmp/fonts/chars-article.txt --collect=none --out=serif-sc-article-700.woff2",
    "fonts:build": "node scripts/build-font-subset.cjs",
    "fonts:build:display": "node scripts/build-font-subset.cjs --weight=700 --chars=.tmp/fonts/chars-display.txt --collect=collect-display-charset.cjs",
    "textures:moon": "node scripts/gen-moon-texture.cjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.13",
    "@tanstack/react-query": "^5.62.7",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.6"
  }
}

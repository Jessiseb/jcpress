# ---- brainstorm 视觉稿（brainstorming skill 产出，不入库）----
.superpowers/

# ---- 工作区临时产物（截图、参考站抓取、Playwright profile）----
# .tmp/tools/ 例外：那里的验收脚本（行为断言、对比度审计、令牌探针、裁图）是当前环境下
# 唯一可运行的验收手段，必须入库；其余临时产物一概忽略。
.tmp/*
!.tmp/tools

# ---- 前端 ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
frontend/.tmp/
# 三期生产构建产物（.tmp/tools/build-p3.sh 的输出与中间目录；体积 MB 级不入库）
frontend/.tmp-build/
frontend/.tmp-build.new/
# TypeScript 增量构建缓存：机器相关、会随编译变动，入库只会制造无意义的 diff
*.tsbuildinfo

# ---- 后端 ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- 密钥与环境变量 ----
.env
.env.*
!.env.example
*.pem
*.p12
*.jks

# ---- 日志与运行时 ----
*.log
logs/
*.pid

# ---- 编辑器与系统 ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
.workbuddy/

# ---- Agent 工具生成物（不入库）----
# openspec / skills CLI 会为每个 agent 工具各装一份相同的 skills 与斜杠命令
# （.agents 通用 + .claude / .codebuddy / .trae，四份内容重复约 620KB）。
# 它们是可再生成的：`openspec update` 或 `npx skills add …`。
# 注意：openspec/ 是**规格基线**，必须入库 —— 这里只忽略工具的生成物。
.agents/
.claude/
.codebuddy/
.trae/

# ---- 测试与覆盖率 ----
coverage/
.nyc_output/

# ---- 上传文件（本地存储模式下不入库）----
uploads/

# ---- brainstorm 视觉稿（brainstorming skill 产出，不入库）----
.superpowers/

# ---- 工作区临时产物（截图、参考站抓取、Playwright profile）----
# .tmp/tools/ 例外：那里的验收脚本（行为断言、对比度审计、令牌探针、裁图）是当前环境下
# 唯一可运行的验收手段，必须入库；其余临时产物一概忽略。
.tmp/*
!.tmp/tools

# ---- 前端 ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
frontend/.tmp/
# TypeScript 增量构建缓存：机器相关、会随编译变动，入库只会制造无意义的 diff
*.tsbuildinfo

# ---- 后端 ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- 密钥与环境变量 ----
.env
.env.*
!.env.example
*.pem
*.p12
*.jks

# ---- 日志与运行时 ----
*.log
logs/
*.pid

# ---- 编辑器与系统 ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
.workbuddy/

# ---- 测试与覆盖率 ----
coverage/
.nyc_output/

# ---- 上传文件（本地存储模式下不入库）----
uploads/

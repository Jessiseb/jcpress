# 服务器环境变量模板
#
#   cp backend/.env.example backend/.env && vi backend/.env
#
# .env 已在 .gitignore 里，不会入库。deploy 脚本启动前用
# `set -a; . .env; set +a` 读它，所以这里的变量对 Spring Boot 直接可见。

# ---------------- MySQL（application-prod.yml）----------------
# 只有 MySQL 与后端不在同一台机器时才需要改；同机保持 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_PASSWORD=

# ---------------- Redis（application-prod.yml）----------------
# 本机 6338 端口，已开 requirepass
REDIS_PASSWORD=

# ---------------- AI 生成文章（application.yml 的 jcpress.ai）----------------
# 走 OpenAI 兼容协议（POST {base-url}/chat/completions），换服务商只改前两行
JCPRESS_AI_BASE_URL=https://api.deepseek.com
JCPRESS_AI_MODEL=deepseek-flash
JCPRESS_AI_API_KEY=

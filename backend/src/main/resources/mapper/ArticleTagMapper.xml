<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jcpress.repository.ArticleTagMapper">

    <select id="listTagRefsByArticleIds" resultType="com.jcpress.domain.projection.ArticleTagRef">
        SELECT at.article_id, t.name, t.slug
        FROM article_tag at
        INNER JOIN tag t ON t.id = at.tag_id
        WHERE at.article_id IN
        <foreach collection="articleIds" item="articleId" open="(" separator="," close=")">
            #{articleId}
        </foreach>
        ORDER BY at.article_id ASC, t.id ASC
    </select>

    <delete id="deleteByArticleId">
        DELETE FROM article_tag WHERE article_id = #{articleId}
    </delete>
</mapper>
